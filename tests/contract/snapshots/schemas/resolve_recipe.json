{
  "input": {
    "additionalProperties": false,
    "properties": {
      "routing": {
        "description": "A routing Handle, such as ``routing_7f3a9c2e``.",
        "type": "string"
      },
      "hyperparameters": {
        "anyOf": [
          {
            "items": {
              "additionalProperties": false,
              "description": "Hyperparameters you set on one unit, over the ones the recipe resolves.",
              "properties": {
                "unit_id": {
                  "description": "The unit to tune, as ``resolve_recipe`` lists it: ``mice``, ``knn``, or ``<strategy>:<column>`` such as ``mnar:income``.",
                  "type": "string"
                },
                "hyperparameters": {
                  "description": "The record of the unit's strategy, picked by ``kind``: ``mice``, ``knn``, ``mnar`` or ``cluster_conditional``. Only those strategies have hyperparameters. A null field keeps the resolved value.",
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "description": "Dials of the ``mice`` unit, the joint MICE block. Null keeps the recipe's resolved value.",
                      "properties": {
                        "kind": {
                          "description": "Always ``mice``.",
                          "type": "string",
                          "enum": [
                            "mice"
                          ]
                        },
                        "max_iter": {
                          "anyOf": [
                            {
                              "type": "integer"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Most imputation rounds the block runs. Constraints: at least 1."
                        },
                        "tol": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Convergence tolerance: the block stops once a round changes the fill by less than this. Constraints: at least 0."
                        },
                        "initial_strategy": {
                          "anyOf": [
                            {
                              "enum": [
                                "mean",
                                "median"
                              ],
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Which statistic fills missing cells before the first round."
                        },
                        "n_nearest_features": {
                          "anyOf": [
                            {
                              "type": "integer"
                            },
                            {
                              "type": "string",
                              "enum": [
                                "all"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Most predictors each column's model reads, the most correlated first. ``all`` reads every active numeric column. Constraints: at least 1."
                        }
                      },
                      "required": [
                        "kind",
                        "max_iter",
                        "tol",
                        "initial_strategy",
                        "n_nearest_features"
                      ],
                      "type": "object"
                    },
                    {
                      "additionalProperties": false,
                      "description": "Dials of the ``knn`` unit, the joint KNN block. Null keeps the recipe's resolved value.",
                      "properties": {
                        "kind": {
                          "description": "Always ``knn``.",
