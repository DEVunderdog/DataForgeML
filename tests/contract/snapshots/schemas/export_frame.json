{
  "input": {
    "additionalProperties": false,
    "properties": {
      "frame": {
        "description": "A frame Handle, such as ``frame_7f3a9c2e``.",
        "type": "string"
      }
    },
    "required": [
      "frame"
    ],
    "type": "object"
  },
  "output": {
    "additionalProperties": false,
    "description": "Where the exported CSV is.",
    "properties": {
      "warnings": {
        "additionalProperties": false,
        "description": "Caveats on this result, most actionable first. Empty when there are none.",
        "properties": {
          "fields": {
            "description": "Always exactly `code`, `message`, `columns`, `param`, `hint`, in this order. A row's value at position i is the field named here at i.",
            "items": {
              "enum": [
                "code",
                "message",
                "columns",
                "param",
                "hint"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "rows": {
            "description": "A caveat on a successful result: it worked, but read this first. One row per record, its values in `fields` order. The i-th schema below describes position i.",
            "items": {
              "items": {
                "anyOf": [
                  {
                    "description": "Position 0, `code`: The warning's Error Code. Branch on this, not on ``message``.",
                    "type": "string"
                  },
                  {
                    "description": "Position 1, `message`: What happened and what to do, in one or two sentences.",
                    "type": "string"
                  },
                  {
                    "anyOf": [
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Position 2, `columns`: Columns the warning concerns, or null."
                  },
                  {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Position 3, `param`: The argument the warning concerns, or null."
                  },
                  {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Position 4, `hint`: Library-written advice, or null."
                  }
                ]
              },
              "type": "array"
            },
            "type": "array"
          }
        },
        "required": [
          "fields",
          "rows"
        ],
        "type": "object"
      },
      "omitted": {
        "additionalProperties": false,
        "description": "One entry per list that was cut, naming the Operation that returns the rest. Empty when nothing was cut.",
        "properties": {
          "fields": {
            "description": "Always exactly `field`, `shown`, `total`, `operation`, in this order. A row's value at position i is the field named here at i.",
            "items": {
              "enum": [
                "field",
                "shown",
                "total",
                "operation"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "rows": {
            "description": "A capped list was cut. Call ``operation`` to read the rest. One row per record, its values in `fields` order. The i-th schema below describes position i.",
            "items": {
              "items": {
                "anyOf": [
                  {
                    "description": "Position 0, `field`: Name of the list field that was cut.",
                    "type": "string"
                  },
                  {
                    "description": "Position 1, `shown`: How many items the list holds.",
                    "type": "integer"
                  },
                  {
                    "description": "Position 2, `total`: How many items exist.",
                    "type": "integer"
                  },
                  {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Position 3, `operation`: The Operation that returns the rest, or null when no Operation does."
                  }
                ]
              },
              "type": "array"
            },
            "type": "array"
          }
        },
        "required": [
          "fields",
          "rows"
        ],
        "type": "object"
      },
      "path": {
        "description": "Absolute path of the CSV, inside the Workspace's ``exports/`` folder.",
        "type": "string"
      }
    },
    "required": [
      "warnings",
      "omitted",
      "path"
    ],
    "type": "object"
  }
}
